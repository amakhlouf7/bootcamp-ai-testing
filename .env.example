# Copy this file to .env and fill in your values
# Never commit .env — it contains secrets

# LLMProxy (RCA + Auto-Healing)
LLM_PROXY_URL=https://management.llmproxy.ai.orange
LLM_MODEL=openai/gpt-4o-mini
LLM_PROXY_KEY=your_llmproxy_key_here

# Jira / Xray
JIRA_URL=https://your-jira-instance.com
JIRA_TOKEN=your_bearer_token_here
PROJECT_KEY=YOUR_PROJECT
USER_STORY_KEY=YOUR_PROJECT-000
REVIEW_TRANSITION_ID=
REVIEW_TRANSITION_NAME=In Review
LOG_LEVEL=INFO

# Confluence
CONFLUENCE_URL=https://your-confluence-instance.com
CONFLUENCE_TOKEN=your_confluence_token_here
CONFLUENCE_SPACE_KEY=YOUR_SPACE
CONFLUENCE_PARENT_PAGE_ID=

# Bilan Test Sprint — Page Confluence avec KPIs JQL
SPRINT_NAME=Sprint 42
SPRINT_REPORT_PAGE_TITLE=Bilan Test Sprint

# JQL personnalisés pour les KPIs (optionnels — générés automatiquement depuis PROJECT_KEY si absents)
JQL_ALL_TESTS=project = "YOUR_PROJECT" AND issuetype = Test ORDER BY created DESC
JQL_PASSED=project = "YOUR_PROJECT" AND issuetype = Test AND status in ("Pass","Passed") ORDER BY created DESC
JQL_FAILED=project = "YOUR_PROJECT" AND issuetype = Test AND status in ("Fail","Failed") ORDER BY created DESC
JQL_BLOCKED=project = "YOUR_PROJECT" AND issuetype = Test AND status = "Blocked" ORDER BY created DESC
JQL_NOT_EXECUTED=project = "YOUR_PROJECT" AND issuetype = Test AND status in ("To Do","Open") ORDER BY created DESC
