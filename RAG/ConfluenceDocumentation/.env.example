# ── Bilan Confluence RAG — Variables d'environnement ──────────────────────────
# Copiez ce fichier en ".env" et renseignez vos valeurs.
# Ne commitez jamais le fichier .env (ajoutez-le à .gitignore).

# ── Jira ──────────────────────────────────────────────────────────────────────
JIRA_URL=https://your-jira-instance.atlassian.net
JIRA_TOKEN=your_jira_personal_access_token

# ── Confluence ────────────────────────────────────────────────────────────────
CONFLUENCE_URL=https://your-confluence-instance.atlassian.net
CONFLUENCE_TOKEN=your_confluence_personal_access_token

# ID de la page parente "CoachTestC2S" (récupéré dans l'URL Confluence)
CONFLUENCE_PARENT_PAGE_ID=123456789

# Clé de l'espace Confluence (ex: CTC2S)
CONFLUENCE_SPACE_KEY=CTC2S

# ── Projet & Sprint ───────────────────────────────────────────────────────────
PROJECT_KEY=CTC2S
SPRINT_NAME=Sprint 42
BILAN_PAGE_TITLE=Bilan Test — Sprint 42

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Optionnel — modèle par défaut : claude-opus-4-5
# CLAUDE_MODEL=claude-opus-4-5

# ── ChromaDB (Vector Store) ───────────────────────────────────────────────────
# Répertoire de persistance local (relatif au répertoire d'exécution)
CHROMA_PERSIST_DIR=./chroma_kpi_db

# ── JQL Personnalisés (optionnels — des valeurs par défaut sont générées) ──────
# JQL_ALL_TESTS=project = "CTC2S" AND issuetype = Test ORDER BY created DESC
# JQL_PASSED=project = "CTC2S" AND issuetype = Test AND status in ("Pass","Passed") ORDER BY created DESC
# JQL_FAILED=project = "CTC2S" AND issuetype = Test AND status in ("Fail","Failed") ORDER BY created DESC
# JQL_BLOCKED=project = "CTC2S" AND issuetype = Test AND status = "Blocked" ORDER BY created DESC
# JQL_NOT_EXECUTED=project = "CTC2S" AND issuetype = Test AND status in ("To Do","Open") ORDER BY created DESC
# JQL_BUGS_OPEN=project = "CTC2S" AND issuetype = Bug AND status != Done ORDER BY priority DESC
# JQL_BUGS_CRITICAL=project = "CTC2S" AND issuetype = Bug AND priority in ("Critical","Blocker") AND status != Done
# JQL_BUGS_RESOLVED=project = "CTC2S" AND issuetype = Bug AND status = Done AND updated >= -30d
# JQL_TESTS_AUTOMATED=project = "CTC2S" AND issuetype = Test AND labels = "automated" ORDER BY created DESC
